# Backend Environment Variables
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/admire_platform

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-production-min-32-chars

# Frontend
FRONTEND_URL=http://localhost:3001

# AWS S3 (for media storage)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=admire-platform
AWS_S3_REGION=us-east-1

# Payment Gateway
PAYMENT_GATEWAY_URL=https://payment.verotel.com
PAYMENT_GATEWAY_KEY=your_payment_gateway_key
PAYMENT_GATEWAY_SECRET=your_payment_gateway_secret

# Age Verification (Persona.com)
PERSONA_URL=https://verify.persona.com
PERSONA_API_KEY=your_persona_api_key

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Redis (for caching and sessions)
REDIS_URL=redis://localhost:6379

# Content Detection API
CONTENT_DETECTION_API=aws-rekognition
AWS_REKOGNITION_BUCKET=admire-moderation

# Admin Email for escalations
ADMIN_EMAIL=admin@admire.com.br

# Brazil-specific settings
LEGAL_JURISDICTION=Brazil
COMPLIANCE_LEVEL=high
CHILD_PROTECTION_MODE=enabled
