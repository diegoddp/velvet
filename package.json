{
  "name": "admire-platform",
  "version": "1.0.0",
  "description": "Adult content platform for verified 18+ users in Brazil with strong compliance",
  "private": true,
  "workspaces": [
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
